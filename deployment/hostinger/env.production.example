# ==============================================================================
# Advanced Dental Clinic - Production Environment Configuration for Hostinger
# Rename this file to '.env' inside the 'backend/' directory on Hostinger
# ==============================================================================

APP_NAME="Advanced Dental Clinic"
APP_ENV=production
APP_KEY=base64:eU8QWzJ8R9L1sK3V5X7Z9B2D4F6H8J0L2N4P6R8T0V=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://demo.ratneshsharma.com/advanced-dental-clinic

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Hostinger MySQL 8 Database Configuration
# Create these in Hostinger hPanel -> Databases -> MySQL Databases
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_advanced_dental
DB_USERNAME=u123456789_dental_user
DB_PASSWORD=YourStrongDatabasePasswordHere

# Session & Cache Settings
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Hostinger SMTP Configuration (Titan / Hostinger Business Email)
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=appointments@demo.ratneshsharma.com
MAIL_PASSWORD=YourEmailPasswordHere
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="appointments@demo.ratneshsharma.com"
MAIL_FROM_NAME="${APP_NAME}"
