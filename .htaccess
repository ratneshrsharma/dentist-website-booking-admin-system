# ==============================================================================
# Advanced Dental Clinic Production & Local Shared Hosting Configuration (Apache / LiteSpeed)
# Dual-Surface: Next.js 15 Multi-Page Static Frontend + Laravel 11 API & AdminLTE 4 Blade
# ==============================================================================

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Force HTTPS (Only in production, bypass on localhost)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Serve root index.html when directory root is accessed
    RewriteRule ^$ index.html [L]

    # 3. Route API requests (/api/*) directly to Laravel Public Index
    RewriteRule ^api(/.*)?$ backend/public/index.php [L,QSA]

    # 4. Route AdminLTE Blade Admin requests (/admin/*) to Laravel Public Index
    RewriteRule ^admin(/.*)?$ backend/public/index.php [L,QSA]

    # 5. Route Storage Symlink (/storage/*) to Laravel Public Storage
    RewriteRule ^storage/(.*)$ backend/public/storage/$1 [L]

    # 6. Serve Static Files directly if they exist on disk (_next, images, css, js)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 7. Serve directory index.html if it exists
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.*)/?$ $1/index.html [L]

    # 8. Serve HTML file if clean URL requested (e.g. /about-us -> /about-us.html)
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]

    # 9. Fallback for Patient-Facing Next.js Portal (Home / 404)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^.*(api|admin|backend|storage)
    RewriteRule ^(.*)$ index.html [L]
</IfModule>

# ==============================================================================
# OWASP TOP 10 SECURITY HARDENING & IMMUNITY HEADERS
# ==============================================================================
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>

# ==============================================================================
# PREVENT DIRECTORY BROWSING & PROTECT SENSITIVE FILES
# ==============================================================================
Options -Indexes

<FilesMatch "(^\.env|\.git|\.lock$|\.json$|\.xml$|\.yml$|\.yaml$|\.md$|\.log$)">
    Order allow,deny
    Deny from all
</FilesMatch>

RedirectMatch 404 ^/(backend/app|backend/bootstrap|backend/config|backend/database|backend/storage/logs)/.*$

# ==============================================================================
# GZIP COMPRESSION
# ==============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ==============================================================================
# BROWSER CACHING FOR STATIC ASSETS
# ==============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
